# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub.

# Your free Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which Groq model to use.
# llama-3.3-70b-versatile is a good free-tier model for this kind of structured extraction task.
GROQ_MODEL=llama-3.3-70b-versatile

# Port the Express server will run on.
PORT=5000

# The URL of your deployed frontend, so CORS allows it to call this API.
# For local development this is usually http://localhost:3000
FRONTEND_URL=http://localhost:3000

# How many CSV rows to send to Groq in a single AI request.
# Smaller batches = more reliable AI answers but more API calls.
BATCH_SIZE=15
